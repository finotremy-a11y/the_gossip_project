<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "The Gossip Project" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "Accueil", root_path, class: "navbar-brand" %>
        
        <% if logged_in? %>
          <%= button_to "Se déconnecter", session_path(session.id), method: :delete,
                class: "btn btn-link text-white p-0 m-0",
                form: { class: "d-inline" } %>
        <% else %>
          <%= link_to "S'inscrire", new_user_path %>
          <%= link_to "Se connecter", new_session_path %>
        <% end %>

        <div class="navbar-nav">
          <%= link_to "Team", static_pages_team_path, class: "nav-link text-white" %>
          <%= link_to "Contact", static_pages_contact_path, class: "nav-link text-white" %>
        </div>
      </div>
    </nav>
    <% if notice %>
      <div class="alert alert-success"><%= notice %></div>
    <% end %>

    <% if alert %>
      <div class="alert alert-danger"><%= alert %></div>
    <% end %>

    <% if flash[:danger] %>
      <div class="alert alert-danger"><%= flash[:danger] %></div>
    <% end %>

    <%= yield %>
    <footer class="bg-dark text-white text-center py-3 mt-5">
      <p class="mb-0">The Gossip Project — THP © <%= Time.now.year %></p>
      <small>Fait par Remy</small>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>

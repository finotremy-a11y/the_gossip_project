<h1>Tag : <%= @tag.title %></h1>

<h2>Gossips associés</h2>

<% @gossips.each do |g| %>
  <div class="card mb-3">
    <div class="card-body">
      <h3><%= link_to g.title, gossip_path(g) %></h3>
      <p><%= truncate(g.content, length: 100) %></p>
      <small>Par <%= g.user.first_name %></small>
    </div>
  </div>
<% end %>

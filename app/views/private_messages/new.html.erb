<h1>Nouveau message privé</h1>

<%= form_with model: @message, local: true do |f| %>

  <%= f.label :content, "Message" %>
  <%= f.text_area :content, class: "form-control" %>

  <%= label_tag :recipients, "Destinataires" %>
  <%= select_tag :recipients,
        options_from_collection_for_select(@users, :id, :first_name),
        multiple: true, class: "form-control" %>

  <%= f.submit "Envoyer", class: "btn btn-primary mt-3" %>
<% end %>

<%= form_with model: gossip do |form| %>

  <div class="mb-3">
    <%= form.label :title %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :content %>
    <%= form.text_area :content, class: "form-control" %>
  </div>

  <!-- SELECT TAGS -->
  <div class="mb-3">
    <%= form.label :tag_ids, "Tags" %>
    <%= form.collection_select :tag_ids, Tag.all, :id, :title,
          {}, { multiple: true, class: "form-select" } %>
  </div>

  <%= form.submit class: "btn btn-success" %>
<% end %>

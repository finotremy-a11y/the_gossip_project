<h1><%= @gossip.title %></h1>

<p><%= @gossip.content %></p>

<p>
  <strong>Auteur :</strong>
  <%= link_to @gossip.user.first_name, user_path(@gossip.user) %>
</p>

<p>
  <strong>Ville :</strong>
  <%= link_to @gossip.user.city.name, city_path(@gossip.user.city) %>
</p>

<hr>

<h3>Likes : <%= @gossip.likes.count %></h3>

<%= link_to "Modifier", edit_gossip_path(@gossip), class: "btn btn-warning" %>

  <%= button_to "Supprimer", gossip_path(@gossip), method: :delete, data: { confirm: "Tu es sûr ?" }, class: "btn btn-danger mt-2" %>

<% if logged_in? %>
  <% if @gossip.likes.exists?(user: current_user) %>
    <% like = @gossip.likes.find_by(user: current_user) %>
    <%= button_to "Je n'aime plus", gossip_like_path(@gossip, like),
          method: :delete, class: "btn btn-danger" %>
  <% else %>
    <%= button_to "J'aime", gossip_likes_path(@gossip), method: :post %>
  <% end %>
<% else %>
  <p class="text-muted">Connecte-toi pour liker.</p>
<% end %>

<hr>

<h3>Tags</h3>

<% @gossip.tags.each do |t| %>
  <%= link_to t.title, tag_path(t), class: "badge bg-info text-dark me-1" %>
<% end %>

<hr>

<h2>Commentaires</h2>

<% @gossip.comments.each do |c| %>
  <div class="mb-2">
    <strong><%= c.user.first_name %> :</strong>
    <%= c.content %>
  </div>
<% end %>

<% if logged_in? %>
  <h3>Ajouter un commentaire</h3>

  <%= form_with model: [@gossip, Comment.new], local: true do |f| %>
    <%= f.text_area :content, class: "form-control", placeholder: "Ton commentaire..." %>
    <%= f.submit "Envoyer", class: "btn btn-primary mt-2" %>
  <% end %>
<% else %>
  <p class="text-muted">Connecte-toi pour commenter.</p>
<% end %>

<%= link_to "Retour", root_path, class: "btn btn-secondary" %>
